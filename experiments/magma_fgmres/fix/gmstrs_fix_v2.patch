+// FIX: certified acceptance test for the GMSTRS result (lean/OptimiKahan/MagmaFixed.lean, fixed_post).
+// Returns true only if, for every column, ||b - op(A) x||_inf < sqrt(n)*eps*BWDMAX*||x||_inf*||op(A)||_inf holds
+// for the EXACT residual: the residual is computed with Dot2 (Ogita-Rump-Oishi 2005), and the test uses the
+// over-approximation of IrsContract.wrapper_sound.  An FP64 residual cannot certify this threshold
+// (IrsContract.fp64_cannot_certify: its error bound (n+1)u exceeds sqrt(n)u).  Non-finite x, or NaN anywhere,
+// makes the test false.  Cost: one O(n^2) host pass (a GPU Dot2 kernel would avoid the transfer).
+static inline void gmstrs_two_sum(double a, double b, double &s, double &e)
+{ s = a + b; double z = s - a; e = (a - (s - z)) + (b - z); }
+
+static bool magma_dgmstrs_certify(
+    magma_trans_t trans, magma_int_t n, magma_int_t nrhs,
+    magmaDouble_const_ptr dA, magma_int_t ldda,
+    magmaDouble_const_ptr dB, magma_int_t lddb,
+    magmaDouble_const_ptr dX, magma_int_t lddx,
+    double bwdmax, magma_queue_t queue )
+{
+    const double u = lapackf77_dlamch("Epsilon");   // 2^-53, unit roundoff
+    const double dn = (double) n;
+    if ( !(dn * u < 0.005) ) return false;
+    // error-bound constants, rounded up: eps >= u/(1-u), gA >= gamma_n, gR >= gamma_{n+1}^2/(1-u)
+    const double eps_ = 2.0*u;
+    const double gA   = 1.01*dn*u;
+    const double gR   = 1.01*(1.01*(dn + 1.0)*u)*(1.01*(dn + 1.0)*u);
+    const double c    = std::sqrt(dn) * u * bwdmax;  // documented constant
+    std::vector<double> A( (size_t)n*n ), B( (size_t)n*nrhs ), X( (size_t)n*nrhs );
+    magma_dgetmatrix( n, n,    dA, ldda, A.data(), n, queue );
+    magma_dgetmatrix( n, nrhs, dB, lddb, B.data(), n, queue );
+    magma_dgetmatrix( n, nrhs, dX, lddx, X.data(), n, queue );
+    auto opA = [&]( magma_int_t i, magma_int_t j ) {
+        return trans == MagmaNoTrans ? A[ i + (size_t)j*n ] : A[ j + (size_t)i*n ]; };
+    double Ah = 0;                                   // computed ||op(A)||_inf
+    for ( magma_int_t i = 0; i < n; i++ ) {
+        double rs = 0;
+        for ( magma_int_t j = 0; j < n; j++ ) rs += std::fabs( opA(i,j) );
+        if ( !std::isfinite(rs) ) return false;
+        if ( rs > Ah ) Ah = rs;
+    }
+    for ( magma_int_t k = 0; k < nrhs; k++ ) {
+        const double *x = &X[ (size_t)k*n ], *b = &B[ (size_t)k*n ];
+        double Xn = 0, Bn = 0, Rh = 0;               // ||x||_inf, ||b||_inf are exact
+        for ( magma_int_t i = 0; i < n; i++ ) {
+            if ( !std::isfinite(x[i]) || !std::isfinite(b[i]) ) return false;
+            Xn = std::fmax( Xn, std::fabs(x[i]) );
+            Bn = std::fmax( Bn, std::fabs(b[i]) );
+        }
+        for ( magma_int_t i = 0; i < n; i++ ) {      // Dot2 of (b_i, -op(A)(i,:)) with (1, x)
+            double s = b[i], cc = 0, p, ep, es;
+            for ( magma_int_t j = 0; j < n; j++ ) {
+                p  = -opA(i,j) * x[j];
+                ep = std::fma( -opA(i,j), x[j], -p );   // TwoProduct
+                gmstrs_two_sum( s, p, s, es );
+                cc += es + ep;
+            }
+            const double r = std::fabs( s + cc );
+            if ( !std::isfinite(r) ) return false;
+            if ( r > Rh ) Rh = r;
+        }
+        // L >= exact left side, R <= exact right side of wrapper_sound's test (outward rounding 1 +- 16u)
+        const double L = ( (1.0 + eps_)*Rh + gR*( Bn + Xn*( Ah/(1.0 - gA) ) ) ) * (1.0 + 16.0*u);
+        const double R = ( c*Xn*( Ah/(1.0 + gA) ) ) * (1.0 - 16.0*u);
+        if ( !(L < R) ) return false;
+    }
+    return true;
+}
