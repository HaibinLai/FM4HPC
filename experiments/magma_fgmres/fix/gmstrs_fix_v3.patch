+/*
+    Row-wise kernels for the certified GMSTRS acceptance test (src/dxgesv_gmres_gpu.cpp, magma_dgmstrs_certify).
+    One thread per row, the SAME operation sequence as the host version it replaces:
+      rowsum[i] = sum_j |op(A)(i,j)|                                   (sequential in j, round-to-nearest adds)
+      resid[i]  = | s + cc |,  Dot2 of (b_i, -op(A)(i,:)) with (1, x)   (TwoProduct by fma, TwoSum, sequential in j)
+    The __d*_rn intrinsics keep each operation a separately rounded IEEE operation (no contraction).
+*/
+#include "magma_internal.h"
+
+__device__ static inline void gmstrs_two_sum_dev(double a, double b, double &s, double &e)
+{ s = __dadd_rn(a, b); double z = __dsub_rn(s, a); e = __dadd_rn(__dsub_rn(a, __dsub_rn(s, z)), __dsub_rn(b, z)); }
+
+__global__ static void dgmstrs_rows_kernel(
+    int notrans, int n, const double* __restrict__ A, int lda,
+    const double* __restrict__ b, const double* __restrict__ x,
+    double* __restrict__ resid, double* __restrict__ rowsum )
+{
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    double rs = 0, s = b ? b[i] : 0.0, cc = 0, p, ep, es;
+    for (int j = 0; j < n; j++) {
+        double a = notrans ? A[i + (size_t)j*lda] : A[j + (size_t)i*lda];
+        if (rowsum) rs = __dadd_rn(rs, fabs(a));
+        if (resid) {
+            p  = __dmul_rn(-a, x[j]);
+            ep = fma(-a, x[j], -p);                 // TwoProduct
+            gmstrs_two_sum_dev(s, p, s, es);
+            cc = __dadd_rn(cc, __dadd_rn(es, ep));
+        }
+    }
+    if (rowsum) rowsum[i] = rs;
+    if (resid)  resid[i]  = fabs(__dadd_rn(s, cc));
+}
+
+extern "C" void
+magmablas_dgmstrs_rows(
+    magma_trans_t trans, magma_int_t n,
+    magmaDouble_const_ptr dA, magma_int_t ldda,
+    magmaDouble_const_ptr db, magmaDouble_const_ptr dx,
+    magmaDouble_ptr dresid, magmaDouble_ptr drowsum,
+    magma_queue_t queue )
+{
+    const int nt = 128;
+    dim3 grid( magma_ceildiv( n, nt ) );
+    dgmstrs_rows_kernel<<< grid, nt, 0, queue->cuda_stream() >>>(
+        trans == MagmaNoTrans, (int) n, dA, (int) ldda, db, dx, dresid, drowsum );
+}
